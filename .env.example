DEBUG=True
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=sqlite:///db.sqlite3
TIME_ZONE=America/Bogota

# IA - OCR
OCR_PROVIDER=google            # google | fake
GOOGLE_APPLICATION_CREDENTIALS=./credentials/vision-sa.json   # opción A: JSON de cuenta de servicio
GOOGLE_VISION_API_KEY=                                         # opción B: llave de API (si se llena, tiene prioridad)

# IA - LLM
INSIGHT_PROVIDER=groq          # groq | rules
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b # verificar modelos disponibles en console.groq.com

MAX_UPLOAD_MB=8
